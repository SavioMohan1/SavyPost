# SavyPost Environment Configuration

SAVYPOST_HOST=127.0.0.1
SAVYPOST_PORT=8765

# Local SQLite Database Path (Optional, defaults to data/savypost.db)
# SAVYPOST_DB_PATH=data/savypost.db

# Optional LLM Configuration for AI Campaign Generation
# Can point to local Ollama (default), LM Studio, vLLM, or OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3:latest
LLM_API_KEY=

# Live Platform Credentials (Can also be added directly in the Web UI Vault)
# TELEGRAM_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=
# BLUESKY_IDENTIFIER=
# BLUESKY_APP_PASSWORD=
# X_BEARER_TOKEN=
# LINKEDIN_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
